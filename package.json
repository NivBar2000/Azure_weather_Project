{
  "name": "azure-weather-project",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo foundation for a weather forecast web application.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names frontend,backend --prefix-colors cyan,magenta \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --workspace=@azure-weather/frontend",
    "dev:backend": "npm run start:dev --workspace=@azure-weather/backend",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migration:generate": "npm run migration:generate --workspace=@azure-weather/backend --",
    "db:migrate": "npm run migration:run --workspace=@azure-weather/backend",
    "db:migration:revert": "npm run migration:revert --workspace=@azure-weather/backend",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2"
  }
}
